{
  "functions": {
    "api/town.js": {
      "includeFiles": "app.html"
    },
    "api/page.js": {
      "includeFiles": "app.html"
    },
    "api/fam.js": {
      "includeFiles": "family.js"
    },
    "api/seo.js": {
      "includeFiles": "app.html"
    },
    "api/remembrance.js": {
      "includeFiles": "app.html"
    },
    "api/province.js": {
      "includeFiles": "app.html"
    },
    "api/sports.js": {
      "includeFiles": "app.html"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/seo?slug=_home"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/province",
      "destination": "/api/province"
    },
    {
      "source": "/province/:name([a-z-]+)",
      "destination": "/api/province?name=:name"
    },
    {
      "source": "/:slug([a-z0-9-]+-(?:sk|mb|ab|bc|on|qc|nb|ns|pe|nl|yt|nt|nu))",
      "destination": "/api/seo?slug=:slug"
    },
    {
      "source": "/:slug([a-z0-9-]+-(?:sk|mb|ab|bc|on|qc|nb|ns|pe|nl|yt|nt|nu))/archive",
      "destination": "/api/seo?slug=:slug&sub=archive"
    },
    {
      "source": "/:slug([a-z0-9-]+-(?:sk|mb|ab|bc|on|qc|nb|ns|pe|nl|yt|nt|nu))/remembrance",
      "destination": "/api/remembrance?slug=:slug"
    },
    {
      "source": "/:slug([a-z0-9-]+-(?:sk|mb|ab|bc|on|qc|nb|ns|pe|nl|yt|nt|nu))/remembrance/:id([A-Za-z0-9._-]+)",
      "destination": "/api/remembrance?slug=:slug&id=:id"
    },
    {
      "source": "/:slug([a-z0-9-]+-(?:sk|mb|ab|bc|on|qc|nb|ns|pe|nl|yt|nt|nu))/sports",
      "destination": "/api/sports?slug=:slug"
    }
  ]
}
