{
  "functions": {
    "api/town.js": {
      "includeFiles": "app.html"
    },
    "api/page.js": {
      "includeFiles": "app.html"
    },
    "api/fam.js": {
      "includeFiles": "family.js"
    },
    "api/seo.js": {
      "includeFiles": "app.html"
    },
    "api/remembrance.js": {
      "includeFiles": "app.html"
    },
    "api/province.js": {
      "includeFiles": "app.html"
    },
    "api/sports.js": {
      "includeFiles": "app.html"
    },
    "api/contact.js": {
      "includeFiles": "app.html"
    },
    "api/extra.js": {
      "includeFiles": "app.html"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/seo?slug=_home"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap-core.xml",
      "destination": "/api/sitemap?part=core"
    },
    {
      "source": "/sitemap-remembrance-:n([0-9]+).xml",
      "destination": "/api/sitemap?part=rem&n=:n"
    },
    {
      "source": "/anniversary",
      "destination": "/api/extra?kind=anniversary"
    },
    {
      "source": "/partners/funeral-homes",
      "destination": "/api/extra?kind=partners"
    },
    {
      "source": "/share-a-book",
      "destination": "/api/book-upload"
    },
    {
      "source": "/contact",
      "destination": "/api/contact"
    },
    {
      "source": "/province",
      "destination": "/api/province"
    },
    {
      "source": "/province/:name([a-z-]+)",
      "destination": "/api/province?name=:name"
    },
    {
      "source": "/:slug([^/.]+-(?:sk|mb|ab|bc|on|qc|nb|ns|pe|nl|yt|nt|nu))",
      "destination": "/api/seo?slug=:slug"
    },
    {
      "source": "/:slug([^/.]+-(?:sk|mb|ab|bc|on|qc|nb|ns|pe|nl|yt|nt|nu))/archive",
      "destination": "/api/seo?slug=:slug&sub=archive"
    },
    {
      "source": "/:slug([^/.]+-(?:sk|mb|ab|bc|on|qc|nb|ns|pe|nl|yt|nt|nu))/remembrance",
      "destination": "/api/remembrance?slug=:slug"
    },
    {
      "source": "/:slug([^/.]+-(?:sk|mb|ab|bc|on|qc|nb|ns|pe|nl|yt|nt|nu))/remembrance/:id([A-Za-z0-9._-]+)",
      "destination": "/api/remembrance?slug=:slug&id=:id"
    },
    {
      "source": "/:slug([^/.]+-(?:sk|mb|ab|bc|on|qc|nb|ns|pe|nl|yt|nt|nu))/remembrance/:id([A-Za-z0-9._-]+)/honour",
      "destination": "/api/remembrance?slug=:slug&id=:id&honour=1"
    },
    {
      "source": "/honour/thanks",
      "destination": "/api/remembrance?thanks=1"
    },
    {
      "source": "/donate/thanks",
      "destination": "/api/remembrance?donatethanks=1"
    },
    {
      "source": "/books/checkout",
      "destination": "/api/extra?kind=book&checkout=1"
    },
    {
      "source": "/books",
      "destination": "/api/extra?kind=book&index=1"
    },
    {
      "source": "/books/thanks",
      "destination": "/api/extra?kind=book&thanks=1"
    },
    {
      "source": "/books/unsubscribe",
      "destination": "/api/extra?kind=book&unsub=1"
    },
    {
      "source": "/:slug([^/.]+-(?:sk|mb|ab|bc|on|qc|nb|ns|pe|nl|yt|nt|nu))/sports",
      "destination": "/api/sports?slug=:slug"
    },
    {
      "source": "/:slug([^/.]+-(?:sk|mb|ab|bc|on|qc|nb|ns|pe|nl|yt|nt|nu))/book/preview",
      "destination": "/api/extra?kind=book&slug=:slug&look=1"
    },
    {
      "source": "/:slug([^/.]+-(?:sk|mb|ab|bc|on|qc|nb|ns|pe|nl|yt|nt|nu))/book/sample",
      "destination": "/api/extra?kind=book&slug=:slug&sample=1"
    },
    {
      "source": "/:slug([^/.]+-(?:sk|mb|ab|bc|on|qc|nb|ns|pe|nl|yt|nt|nu))/book",
      "destination": "/api/extra?kind=book&slug=:slug"
    },
    {
      "source": "/:slug([^/.]+-(?:sk|mb|ab|bc|on|qc|nb|ns|pe|nl|yt|nt|nu))/family/:name([A-Za-z-]+)",
      "destination": "/api/extra?kind=family&slug=:slug&name=:name"
    }
  ]
}
